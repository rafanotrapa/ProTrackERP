PORT=
MONGO_URI=
JWT_SECRET=

# SMTP Brevo. Dipakai untuk email reset password dan notifikasi alur kerja.
# EMAIL_HOST dan EMAIL_PORT boleh dikosongkan — bawaannya sudah
# smtp-relay.brevo.com:587 (lihat utils/emailService.js).
EMAIL_HOST=
EMAIL_PORT=

# Login SMTP Brevo, berformat <angka>@smtp-brevo.com — BUKAN alamat pengirim.
EMAIL_USER=
# SMTP Key dari dashboard Brevo, diawali xsmtpsib-
EMAIL_PASS=
# Alamat pengirim yang sudah diverifikasi di Brevo. WAJIB: tanpa ini seluruh
# pengiriman email mati, termasuk reset password.
EMAIL_FROM=
EMAIL_FROM_NAME=

# Basis URL frontend. Menentukan tautan di email reset password DAN tombol
# "Buka di ProTrack" pada email notifikasi.
FRONTEND_URL=
