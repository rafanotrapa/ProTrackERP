# ========================================
# ProTrack ERP - Environment Variables
# Copy file ini jadi ".env" lalu isi nilai aslinya.
# JANGAN commit file .env ke git!
# ========================================

# --- Server ---
PORT=5000

# --- Database ---
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/protrack

# --- Auth ---
JWT_SECRET=ganti_dengan_string_random_panjang

# --- SMTP Brevo (untuk Forgot Password) ---
# Ambil dari dashboard Brevo: SMTP & API > SMTP
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587

# EMAIL_USER = "Login" di dashboard Brevo, formatnya angka@smtp-brevo.com
# INI BUKAN email Brevo lu dan BUKAN nama SMTP key
EMAIL_USER=xxxxxxxx@smtp-brevo.com

# EMAIL_PASS = SMTP Key Value (yang diawali xsmtpsib-)
EMAIL_PASS=xsmtpsib-xxxxxxxxxxxxxxxxxxxx

# EMAIL_FROM = alamat pengirim yang SUDAH diverifikasi di Brevo
# (Brevo > Senders, Domains & Dedicated IPs > Senders)
EMAIL_FROM=emaillu@gmail.com
EMAIL_FROM_NAME=ProTrack ERP

# --- Frontend (dipakai buat bikin link reset password di email) ---
FRONTEND_URL=http://localhost:5173
